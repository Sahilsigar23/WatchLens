# ---------------------------------------------------------------------------
# StudyTrace environment variables
# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Any Postgres works (local, Neon, Supabase, RDS).
#
# Local:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studytrace
#
# On Vercel, ALWAYS use the *pooled* connection string your provider gives you
# (Neon "-pooler" host, Supabase port 6543). Serverless functions open many
# short-lived connections and will exhaust a direct connection limit.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studytrace

# Set to "true" when your provider requires TLS but uses a self-signed chain
# (common on Neon/Supabase/Heroku). Leave unset for a local database.
PGSSL=false

# Secret used to sign the session cookie. Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# OPTIONAL. Only needed for the in-app YouTube search box.
# Without it you can still paste any YouTube URL or video ID and watch it.
# Get one at https://console.cloud.google.com -> enable "YouTube Data API v3".
YOUTUBE_API_KEY=
